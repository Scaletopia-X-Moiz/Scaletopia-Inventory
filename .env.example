SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase credentials — power sign-in and session cookies.
# NEXT_PUBLIC_SUPABASE_URL is the same value as SUPABASE_URL above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the "anon"/"publishable" key from
# Supabase dashboard → Project Settings → API. Safe to expose to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. The public base URL of this app, used to build invite links
# (e.g. https://inventory.scaletopia.com). If unset, it's derived from the
# request host, which is fine for local dev and most single-domain deploys.
NEXT_PUBLIC_SITE_URL=

# Icypeas email verification API key — powers the "Reverify email" buttons.
# https://app.icypeas.com/ → API authorization. Sent as the raw Authorization header. Server-side only.
ICYPEAS_API_KEY=

# Optional. Icypeas API secret, used only to verify the HMAC-SHA1 signature
# on inbound webhook calls (app/api/internal/icypeas-webhook). If unset, the
# webhook receiver skips signature verification entirely (Icypeas's docs call
# this "an optional step" — MVP-ok). Server-side only.
ICYPEAS_API_SECRET=

# Optional. Overrides the public base URL used to build the Icypeas webhook
# callback URL (<base>/api/internal/icypeas-webhook). Normally unnecessary —
# NEXT_PUBLIC_SITE_URL above is reused for this. Only set this if the
# webhook needs a different public host than the app itself (e.g. a tunnel
# in front of local dev). Leaving both unset means Icypeas has no public URL
# to call back to, so reverify falls back to polling instead of a webhook —
# the expected local-dev behavior.
ICYPEAS_WEBHOOK_URL=

# MillionVerifier API key — legacy email verifier (being replaced by Icypeas).
# https://app.millionverifier.com/ → API. Server-side only.
MILLIONVERIFIER_API_KEY=

# ClearoutPhone API token — powers the "Reverify" phone buttons.
# https://clearoutphone.io/ → API. Server-side only. Sent as
# `Authorization: Bearer:<token>` (literal colon, no space).
CLEAROUT_PHONE_API_TOKEN=

# OpenRouter API key — powers the "Clean Names" bulk action, which simplifies
# a messy company name into a short brand name via google/gemini-2.5-flash-lite.
# https://openrouter.ai/ → Keys. Server-side only.
OPENROUTER_API_KEY=
